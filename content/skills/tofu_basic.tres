[resource]
script = ExtResource("skill")
id = &"skill.tofu.basic"
display_name = "Cursed-Tool Slash"
executor = SubResource("Executor")
targeting = SubResource("Target")
rank_scaling = Array[ExtResource("rank")]([SubResource("Rank")])
