[State 0, XMEN Start]
type = VarSet
trigger1 = root,var(6) = 1 && !time
v = 58  
value = 2
ignorehitpause = 1
[State 0, XMEN Rotation]
type = VarAdd
triggerall = root,var(6) = 1
trigger1 = var(55) = -1
v = 58
value = cond(var(58) = 2,1,cond(var(58) = 6,-4,1))
[State 0, ALL Start]
type = VarSet
trigger1 = root,var(6) = 3 && !time
v = 58  
value = 1;1
ignorehitpause = 1
[State 0, ALL Rotation]
type = VarAdd
triggerall = root,var(6) = 3
trigger1 = var(55) = -1
v = 58
value = cond(var(58) = 1,1,cond(var(58) = 3,-2,1));cond(var(58) = 1,1,cond(var(58) = 3,-2,1))
[State 0, RANDOM Start]
type = VarSet
trigger1 = root,var(6) = 4 && !time
;trigger2 = time%120=0
v = 58  
value = 3-random%2
ignorehitpause = 1
[State 0, Random Rotation]
type = VarAdd
triggerall = root,var(6) = 4
trigger1 = time%50=0
v = 58
value = cond(var(58) = 1,1,cond(var(58) = 3,-2,1))
