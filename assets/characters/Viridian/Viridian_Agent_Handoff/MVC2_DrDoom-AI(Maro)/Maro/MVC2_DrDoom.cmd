;-| Button Remapping |-----------------------------------------------------
; This section lets you remap the player's buttons (to easily change the
; button configuration). The format is:
;   old_button=new_button
; If new_button is left blank, the button cannot be pressed.
[Remap]
x=x
y=y
z=z
a=a
b=b
c=c
s=s

