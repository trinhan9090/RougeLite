;=========================================================================
;			性能改変(プレイヤー操作時にも影響)
;=========================================================================
[State AI,Super版 Molecular Shield使用時のゲージ増加封印]
Type=Varset
Trigger1=1
V=49
Value=(0)
;()内の数値が1ならばSuper版 Molecular Shield(以後 岩と呼ぶ)を
;使用時にゲージが増えません
;0だと増えます

[State AI,Super版 Molecular Shield使用時の岩の初期位置変更]
Type=Varset
Trigger1=1
V=43
Value=(1)
;()内の数値が1ならば岩使用時にヘルパーが
;地面から一斉に出てきます。
;0だと場所に応じて出現します。

[State AI,岩の削り無効化]
Type=Varset
Trigger1=Time=0
V=55
Value=(0)
;()内の数値が0なら岩の削りを無効化します
;1だと削ります。
;ちなみにガードの固いAI相手だと削りがないとグダグダに
;なってタイムアップまで決着が付かない可能性があるので注意


;===============================基本AI設定====================================
;==========================================
[State -3, AI Level]
Type=Varset
Trigger1=Time=0
V=59
Value=5
;ここはAIレベルのスイッチです。
;最大が5、最小が1で0にするとAIが起動しません
;AIレベル別に行動制限もありますが下で設定を
;変えることができます。
;==========================================
[State -3, Reaction Speed]
Type=Varset
Trigger1=Time=0
V=58
Value=5
;ここはAIの反応速度スイッチです
;0で格ゲー始めたばかりの人(50F)
;1で何とかガードできるようになってきた人(40F)
;2で大体格ゲーに慣れてきた人間と同じ(30F)
;3で人間＋読み補正(20F)
;4で完全読み(10F)で反応します。
;5で超反応(0F)で反応します。
;※ 反応速度が適用されるのは
;- 切り替えし鬼焼き系＋回避行動
;- ブロッキングとＪＤ
;- 対空技(鬼焼きなど)
;==========================================
[State -3, 常時AI起動]
Type=Varset
Trigger1=Time=0
V=57
Value=1
;ここはAI常時起動スイッチです
;Value=0をValue=1にするとAIが
;常に起動した状態になります

;============================
[State -3, モード]
Type=Varset
Trigger1=Time=0
V=56
Value=2
;1:対人モード
;2:対AIモード
;※詳しくは同封のテキストファイルにて
;
;============================
[State AI, 立ち、しゃがみ、空中状態確認]
Type=Varset
Trigger1=Time=0
Trigger1=Var(56)=1
V=54
Value=15

;こちらは対人モード限定です
;牽制、固め、崩しにおいて相手の
;上中下段を確認するために必要なフレーム数を
;設定できます。
;デフォルトは15フレームです。

;============================
[State AI, ガード確率]
Type=Varset
Trigger1=Time=0
V=53
Value=100
;こちらはガード確率となっています
;ここの数値+%の確率でガードします
;デフォルトは100%です。
;対人モードだとさらに半分になりますので
;ご注意くだしあす

;============================
[State -3, リカバリ封印スイッチ]
Type=Varset
Trigger1=Time=0
V=42
Value=1
;※ここの値が1であればAIが
;　ダウン時のリカバリーロールを
;　使用しなくなります

;============================
[State -3, アドバンスガード封印スイッチ]
Type=Varset
Trigger1=Time=0
V=41
Value=1
;※ここの値が1であればAIが
;　アドバンスガードを
;　使用しなくなります
;
;=========================================================================
;				岩の使用設定
;=========================================================================
;===========================================
[State -3, 岩封印スイッチ]
Type=ParentVarset
Trigger1=Time=0
V=42
Value=(0)
;Value=の()内の数値(0-1)を入力してください
;()内の数値が1ならば岩ボロスを封印、0ならば使用します

;===================================================
;	↓の項目は↑がValue=1のとき関係します
;===================================================
;============================
;	　使用条件
;============================
[State -3, 岩の使用頻度]
Type=ParentVarset
Trigger1=Time=1
V=42 
Value=(5)*10+Root,Var(42)
;Value=の()内の数値(1-10)を入力してください(デフォルトは5)
;(入力した数値の2乗)+％の確率で岩ボロスを使用します

;============================
[State -3, 岩を使用可能にする体力]
Type=ParentVarset
Trigger1=Time=0
V=41
Value=(10)
;Value=の()内の数値(1-10)を入力してください(デフォルトは10)
;(入力した数値)+割 以下の体力で岩ボロスが使用可能となります


;============================
;	　使用時の性能
;============================
[State -3, 出現する岩の数]
Type=ParentVarset
Trigger1=Time=1
V=41
Value=(10)*100+Root,Var(41)
;Value=の()内の数値(1-30)を入力してください(デフォルトは10)
;(入力した数値)個の岩が出現します。
;ただし表示できるヘルパーの数に限りがあるので注意してください

[State -3, 岩使用時の無敵スイッチ]
Type=ParentVarset
Trigger1=Time=0
V=40
Value=1
;Value=の()内の数値(0-1)を入力してください
;()内の数値が1ならば岩ボロス中の無敵が解除、0ならば常時無敵となります
;kong氏のデフォルトAIだと0でした

;============================
[State -3, 発生する岩の寿命フレーム数]
Type=ParentVarset
Trigger1=Time=1
V=40
Value=(899)*10+Root,Var(40)
;Value=の()内の数値(1-999)を入力してください(デフォルトは899)
;(入力した数値)+フレーム間、岩が出現し続けます。

;==============================行動設定===================================
;[AI共通項目]
;============================
[State -3, 開幕前行動]
Type=Varset
Trigger1=1
V=47
Value=(1)
;デフォルトは1です
;()内の数値が1なら行動か、0なら行動不可
;ちなみに行動可能なのは1ラウンド目のみ

;============================
[State -3, VSタッグ時の]
Type=Varset
Trigger1=1
V=48
Value=(1)
;デフォルトは1です
;()内の数値が1なら相手が2人のとき、遠距離からビーム脳。
;0なら通常の立ち回りを行ないます。


;=========================AIレベル別行動設定==============================
;[対AIモード限定]
;============================
[State -3,とどめ]
Type=Varset
Trigger1=1
V=46
Value=4
;AIレベルがここの値を超えるならば
;削りで勝ちにいくようになります。


