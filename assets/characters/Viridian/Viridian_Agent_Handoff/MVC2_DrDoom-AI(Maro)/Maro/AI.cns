Trigger1=RoundState=3
V=53
Value=Var(24)+Var(26)*10

[State 被弾数持越し関係]
Type=Varset
Trigger1=RoundState=1
Trigger1=Enemy,TeamMode=Single
V=24
Value=Var(53)%10

[State 被弾数持越し関係]
Type=Varset
Trigger1=RoundState=1
Trigger1=Enemy,TeamMode=Single
V=26
Value=Var(53)/10

