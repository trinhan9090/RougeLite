triggerall=!alive
trigger1=NumHelper(7760)=0
stateno=7760
id=7760

[State -3, hit ground Sound]
type=PlaySnd
triggerall=Time=1
trigger1=stateno=5100
value=5100,0

[State 130]
type=AssertSpecial
trigger1=1
trigger1=Stateno=[120,155]
flag=NoWalk

[State -3,r]
