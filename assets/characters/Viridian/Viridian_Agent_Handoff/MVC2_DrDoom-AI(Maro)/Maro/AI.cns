;=========================================================================
[State -2, デバック(変数確認)]
Type=DisplayToClipBoard
Trigger1=1
Text="Var(59)=%d,Var(26)=%d,Var(24)=%d,Var(53)=%d,Var(57)=%d\n"
Params=Var(59),Var(26),Var(24),Var(53),Var(57)
IgnoreHitPause=1

[State -2, 距離確認デバック]
type=AppendToClipboard
Trigger1=1
text= "P2X:%f,P2Y:%f,Vx%f,Vy%f,H-Var(10)=%d \n"
params=P2bodyDist x,P2BodyDist y,vel x,vel y,Helper(7000),Var(59)%10000/1000
IgnoreHitPause=1
;==============================================================
;生死確認
[State -3,tag]
type=Varset
Trigger1=Var(59)>0
Trigger1=RoundState=2
Trigger1=NumEnemy=2
var(58)=IfElse(!Enemynear ,Alive,1,0)

;==============================================================
;コンボルートリセット
[State -3, Combo Reset]
Type=Varset
Trigger1=RoundState=2
Trigger1=Enemynear(Var(58)),Movetype!=H
V=53
Value=0
Ignorehitpause=1

