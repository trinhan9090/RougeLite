[State AI,被弾スイッチ]
Type=Varset
TriggerAll=Var(59)>0
TriggerAll=Var(23)=0
Trigger1=Stateno!=[120,159]
Trigger1=Movetype=H
V=23
Value=1

[State AI,被弾スイッチ(解除)]
Type=Varset
Trigger1=Var(23)=2
Trigger1=Movetype!=H
Trigger2=PrevStateno!=610
Trigger2=PrevStateno!=1340
Trigger2=PrevStateno!=1343
V=23
Value=0

[State AI,上段攻撃中の反撃被弾数]
Type=Varadd
Trigger1=Var(23)=1
Trigger1=Movetype=H
Trigger1=PrevStateno=610
Trigger1=(Var(26):=Var(26)+1)||1
Trigger1=(Var(23):=2)||1
V=24
Value=Ifelse(Var(24)<=9,(1+abs(Enemynear(Var(58)),Power-Var(25))<=400),0)

[State 空中ダッシュ被弾数記憶]
Type=Varadd
Trigger1=Var(23)=1
Trigger1=Movetype=H
Trigger1=Helper(7000),Var(19)=1
Trigger1=PrevStateno=1340||PrevStateno=1343
Trigger1=(Var(23):=2)||1
V=26
Value=1

