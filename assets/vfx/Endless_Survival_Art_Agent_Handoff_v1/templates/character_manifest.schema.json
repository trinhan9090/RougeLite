{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Character art manifest",
  "type": "object",
  "required": [
    "character_id",
    "canvas",
    "feet_anchor",
    "directions",
    "animations",
    "visual_profile"
  ],
  "properties": {
    "character_id": {
      "type": "string",
      "pattern": "^[a-z_]+$"
    },
    "canvas": {
      "type": "array",
      "prefixItems": [
        {
          "const": 128
        },
        {
          "const": 128
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "feet_anchor": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "directions": {
      "type": "array",
      "items": {
        "enum": [
          "south",
          "west",
          "east",
          "north"
        ]
      },
      "uniqueItems": true,
      "minItems": 4
    },
    "animations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "fps",
          "loop",
          "directions"
        ],
        "properties": {
          "fps": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "loop": {
            "type": "boolean"
          },
          "directions": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^frames/"
              }
            }
          }
        }
      }
    },
    "visual_profile": {
      "type": "object"
    }
  }
}